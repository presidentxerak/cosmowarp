; ═══════════════════════════════════════════════
; hello_cosmo.cosmo — Premier programme CosmoCode
; Traverse les 7 couches fractales et émet
; l'énergie de chaque couche en sortie
; ═══════════════════════════════════════════════

; Initialisation sur la couche GRID
WARP_INIT       GRID.RΩ, RΩ              ; Init warp sur GRID

; Charge l'énergie de chaque couche
ENERGY_LOAD     GRID.RΩ, #1.0            ; E(GRID) = 1.0
SIGNAL_BURST    GRID.RΩ                  ; Émet 1.0

ENERGY_LOAD     HELIX.RΩ, #1.618         ; E(HELIX) = φ
SIGNAL_BURST    HELIX.RΩ                 ; Émet 1.618

ENERGY_LOAD     GLYPH.RΩ, #3.14          ; E(GLYPH) = π
SIGNAL_BURST    GLYPH.RΩ                 ; Émet 3.14

ENERGY_LOAD     COSMO.RΩ, #7.77          ; E(COSMO) = 7.77
SIGNAL_BURST    COSMO.RΩ                 ; Émet 7.77

ENERGY_LOAD     CHRONOS.RΩ, #13.37       ; E(CHRONOS) = 13.37
SIGNAL_BURST    CHRONOS.RΩ               ; Émet 13.37

ENERGY_LOAD     NEXUS.RΩ, #21.0          ; E(NEXUS) = 21
SIGNAL_BURST    NEXUS.RΩ                 ; Émet 21.0

ENERGY_LOAD     LUMINA.RΩ, #42.0         ; E(LUMINA) = 42
SIGNAL_BURST    LUMINA.RΩ                ; Émet 42.0

; Sens cosmique final
COSMO_SENSE     LUMINA.RΩ                ; Énergie totale → RΩ
SIGNAL_BURST    LUMINA.RΩ                ; Émet l'énergie totale
