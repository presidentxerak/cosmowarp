# Strangrz — Environment Configuration
# Copy this file to .env and fill in your credentials.

# ─── Supabase ────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Supabase Service Role (server-side only, never expose to client) ───
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Stripe (payments) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── API Security ───────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_ADMIN_KEY=your_secure_admin_key_here
PAYOUT_SECRET_KEY=your_secure_payout_key_here
PEERS_API_KEY=your_peers_api_key_here
CORS_ORIGIN=https://strangrz.com

# ─── Servers (optional, for local dev) ──────────────────
GATEWAY_PORT=8788
SIGNALING_PORT=8787
