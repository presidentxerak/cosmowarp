# Strangrz — Environment Configuration
# Copy this file to .env and fill in your credentials.
# On Vercel: add these in Settings → Environment Variables.

# ─── Supabase (Frontend — public, safe for browser) ──────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Supabase (Backend — server-side only, NEVER expose to client) ──
# Same project URL as above, but with the service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Stripe (payments) ──────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
# Publishable key (public, used client-side — Vercel: STRIPE_PUBLISHABLE_KEY)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret key (server-side only)
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — create at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://strangrz.com/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── API Security ───────────────────────────────────────
# Generate with: openssl rand -hex 32
GATEWAY_ADMIN_KEY=your_secure_admin_key_here
PAYOUT_SECRET_KEY=your_secure_payout_key_here
CORS_ORIGIN=https://strangrz.com

# ─── P2P Signaling (optional) ──────────────────────────
PEERS_API_KEY=your_peers_api_key_here

# ─── Upstash Redis (optional, for distributed rate limiting) ──
# Without these, rate limiting falls back to in-memory (per-instance).
# UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── API Base URL (optional) ─────────────────────────────
# Used by SettingsView for Stripe Connect API calls.
# Leave empty for same-origin (Vercel deployment). Set for local dev.
# VITE_API_URL=http://localhost:3000

# ─── Servers (optional, for local dev) ──────────────────
GATEWAY_PORT=8788
SIGNALING_PORT=8787
