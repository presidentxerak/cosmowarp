# Strangrz — Environment Configuration
# Copy this file to .env and fill in your credentials.
# On Vercel: add these in Settings → Environment Variables.

# ─── Supabase (Frontend — public, safe for browser) ──────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Supabase (Backend — server-side only, NEVER expose to client) ──
# Same project URL as above, but with the service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Stripe (payments) ──────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
# Publishable key (public, used client-side — Vercel: STRIPE_PUBLISHABLE_KEY)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret key (server-side only)
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — create at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://strangrz.com/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── API Security ───────────────────────────────────────
# Generate with: openssl rand -hex 32
GATEWAY_ADMIN_KEY=your_secure_admin_key_here
PAYOUT_SECRET_KEY=your_secure_payout_key_here
CORS_ORIGIN=https://strangrz.com

# ─── IPFS Storage (decentralized, content-addressed) ──────
# Used for permanent decentralized storage of sold artwork media.
# Gateway: public read access. Pinning API: upload/pin files.
# Supported pinning services: Pinata, web3.storage, nft.storage, Infura IPFS.
#
# Pinata (recommended):
#   Dashboard: https://app.pinata.cloud/developers/api-keys
#   Pricing: https://www.pinata.cloud/pricing (free tier: 1GB, paid: from $20/mo)
VITE_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
VITE_IPFS_PINNING_API_URL=https://api.pinata.cloud
VITE_IPFS_PINNING_API_TOKEN=your_pinata_jwt_here
#
# Alternative gateways (for fallback/read):
#   https://dweb.link/ipfs/
#   https://w3s.link/ipfs/
#   https://cloudflare-ipfs.com/ipfs/
#   https://ipfs.infura.io/ipfs/
#
# Alternative pinning services:
#   web3.storage: VITE_IPFS_PINNING_API_URL=https://api.web3.storage
#   nft.storage:  VITE_IPFS_PINNING_API_URL=https://api.nft.storage
#   Infura IPFS:  VITE_IPFS_PINNING_API_URL=https://ipfs.infura.io:5001

# ─── Arweave Storage via Irys (permanent, immutable) ─────
# Used for permanent immutable storage of sold artwork media.
# Once uploaded, data can never be deleted — truly permanent.
# Pay once per upload (~$5/GB via Arbitrum), no recurring fees.
#
# How it works:
#   1. Platform wallet (IRYS_PRIVATE_KEY) funds an Irys account
#   2. Uploads are paid from that balance (auto-topped-up)
#   3. Data is stored permanently on Arweave
#   4. Files < 100KB are FREE on Irys
#
# Irys docs: https://docs.irys.xyz/onchain-storage/quickstart
# Dashboard: https://irys.xyz
# Pricing:   ~$5/GB one-time (via Arbitrum ETH, cheapest gas)
#
# Gateway (public read access):
VITE_ARWEAVE_GATEWAY_URL=https://arweave.net
#
# Server-side upload (platform wallet — NEVER expose to client):
# Generate a dedicated wallet for Irys uploads. Fund it with a small amount of ETH on Arbitrum.
# Hex private key, with or without 0x prefix.
IRYS_PRIVATE_KEY=your_ethereum_private_key_here
IRYS_NETWORK=mainnet
#
# Legacy HTTP bundler fallback (optional, used if Irys SDK unavailable):
VITE_ARWEAVE_BUNDLER_URL=https://node1.irys.xyz
VITE_ARWEAVE_BUNDLER_TOKEN=your_irys_token_here
#
# Alternative Arweave gateways:
#   https://ar-io.net
#   https://g8way.io

# ─── P2P Signaling (optional) ──────────────────────────
PEERS_API_KEY=your_peers_api_key_here

# ─── Upstash Redis (optional, for distributed rate limiting) ──
# Without these, rate limiting falls back to in-memory (per-instance).
# UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── API Base URL (optional) ─────────────────────────────
# Used by SettingsView for Stripe Connect API calls.
# Leave empty for same-origin (Vercel deployment). Set for local dev.
# VITE_API_URL=http://localhost:3000

# ─── Servers (optional, for local dev) ──────────────────
GATEWAY_PORT=8788
SIGNALING_PORT=8787
